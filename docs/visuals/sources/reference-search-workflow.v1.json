{
  "schema_version": 1,
  "diagram_kind": "architecture",
  "slug": "reference-search-workflow",
  "entry": "bounded-query",
  "title": "Bounded reference-search correctness path",
  "subtitle": "Compile once, verify the complete tenant snapshot, then rank every live current head",
  "description": "Source-derived workflow for RecallLedger's dependency-free lexical reference search. A bounded strict UTF-8 query is compiled before one deferred SQLite read snapshot. The operation enumerates the complete bounded tenant head inventory, proves that no tenant event identity is orphaned from that inventory, reconciles every current head from canonical event bytes, excludes verified tombstones, accounts for every live UTF-8 content byte, scores every live head, sorts the complete match set, and only then applies top-K while retaining current-head citations. Capacity or integrity failure aborts the whole operation. The diagram does not represent authorization, a persistent index, a cryptographic signature, or a latency benchmark.",
  "caption": "Source-derived reference path; complete bounded scan, not a latency benchmark",
  "canvas": {
    "width": 2000,
    "height": 1240
  },
  "bindings": [
    {
      "id": "query-reader",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_read_query",
      "match": "contains",
      "expected": "payload = _read_bounded_query(stdin) if path_text == \"-\" else _read_query_file(path_text)",
      "claim": "The CLI obtains query bytes from its bounded stdin or regular-file reader and decodes strict UTF-8."
    },
    {
      "id": "query-compiler",
      "kind": "python",
      "path": "src/recall_ledger/retrieval.py",
      "target": "compile_lexical_query",
      "match": "contains",
      "expected": "match_expression=\" AND \".join",
      "claim": "The production compiler normalizes bounded text, emits inert encoded terms, and joins every unique term with literal AND."
    },
    {
      "id": "public-search",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SQLiteLedger.search_notes",
      "match": "contains",
      "expected": "self._begin_transaction(connection, immediate=False)",
      "claim": "search_notes compiles the query before opening one deferred read transaction and settles that snapshot before returning."
    },
    {
      "id": "head-inventory",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_load_search_note_ids",
      "match": "contains",
      "expected": "(tenant_id, MAX_SEARCH_HEADS + 1)",
      "claim": "The tenant-head inventory uses a 1,001-row sentinel and rejects more than 1,000 heads."
    },
    {
      "id": "orphan-proof",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_verify_search_event_inventory",
      "match": "contains",
      "expected": "tenant ledger events exist outside the note head inventory",
      "claim": "A bounded distinct-note keyset walk rejects tenant event identities that have no inventoried head."
    },
    {
      "id": "head-verifier",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_load_head",
      "match": "contains",
      "expected": "return _decode_head_row(row)",
      "claim": "Each inventoried identity is loaded through the canonical latest-event and head-projection reconciler."
    },
    {
      "id": "tombstone-exclusion",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_verified_search_corpus",
      "match": "contains",
      "expected": "if event.kind is EventKind.TOMBSTONED:",
      "claim": "The live-content path has an explicit branch for a verified tombstone head."
    },
    {
      "id": "utf8-content-accounting",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_verified_search_corpus",
      "match": "contains",
      "expected": "content_bytes += len(title.encode(\"utf-8\")) + len(body.encode(\"utf-8\"))",
      "claim": "Title and body lengths enter the cumulative live-content counter as UTF-8 bytes."
    },
    {
      "id": "live-content-bound",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_verified_search_corpus",
      "match": "contains",
      "expected": "if content_bytes > MAX_SEARCH_LIVE_CONTENT_BYTES:",
      "claim": "The cumulative live-content byte counter has an explicit configured upper-bound branch."
    },
    {
      "id": "live-head-scoring",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_search_in_transaction",
      "match": "contains",
      "expected": "score = score_lexical_content(query, event.content)",
      "claim": "Each validated live head is passed to the production lexical scorer."
    },
    {
      "id": "match-collection",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_search_in_transaction",
      "match": "contains",
      "expected": "hits.append(",
      "claim": "The transaction explicitly appends each accepted SearchHit to the collected hit list."
    },
    {
      "id": "full-match-sort",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_search_in_transaction",
      "match": "contains",
      "expected": "hits.sort(",
      "claim": "The transaction explicitly sorts the collected hit list."
    },
    {
      "id": "top-k-slice",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_search_in_transaction",
      "match": "contains",
      "expected": "hits=tuple(hits[:limit])",
      "claim": "The returned hit tuple is materialized from the requested list prefix."
    },
    {
      "id": "result-model",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SearchResults",
      "match": "defined",
      "expected": "class",
      "claim": "SearchResults carries the compiled query, total matches, scan accounting, bounded hits, and current-head citations."
    },
    {
      "id": "fail-closed-contract",
      "kind": "contract",
      "path": "docs/storage-boundary.md",
      "target": "bounded-reference-search",
      "match": "contains",
      "expected": "no partial prefix is returned",
      "claim": "Capacity, normalization, token-stream, or integrity failure aborts the whole reference operation without a partial result."
    },
    {
      "id": "scope-contract",
      "kind": "contract",
      "path": "docs/storage-boundary.md",
      "target": "bounded-reference-search",
      "match": "contains",
      "expected": "A citation is a consistency reference, not a signature or an",
      "claim": "The documented search surface is a correctness oracle rather than authorization, a signature, or a persistent performance index."
    }
  ],
