{
  "schema_version": 1,
  "diagram_kind": "state_machine",
  "slug": "transaction-output-retry",
  "entry": "mutation-invocation",
  "title": "Write settlement and retry boundaries",
  "subtitle": "Storage uncertainty and late output failure require different recovery",
  "description": "Source-derived state machine centered on a RecallLedger mutation. It separates the open and write settlement guard from a settled operation, shows exact replay and rollback proof as source-bound invariants, and follows poisoning, code-specific state or busy outcomes, serialization, stdout delivery, recovery guidance, and the final stderr boundary. The outer CLI recovery policy also names same-invocation retries for reads. It does not claim that stdout or stderr delivery is atomic or durably consumed downstream.",
  "caption": "Source-derived failure model; not a runtime screenshot or benchmark",
  "canvas": {
    "width": 1600,
    "height": 1300
  },
  "bindings": [
    {
      "id": "cli-run",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "run_cli",
      "match": "defined",
      "expected": "function",
      "claim": "run_cli separates operation settlement, serialization, and final stream output."
    },
    {
      "id": "write-phases",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "_WriteTransactionPhase",
      "match": "defined",
      "expected": "class",
      "claim": "The storage write guard names five concrete transaction phases."
    },
    {
      "id": "begin-proof",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SQLiteLedger._begin_transaction",
      "match": "defined",
      "expected": "method",
      "claim": "A write becomes active only after BEGIN IMMEDIATE and an active-state proof."
    },
    {
      "id": "exact-replay",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_transition_in_transaction",
      "match": "defined",
      "expected": "function",
      "claim": "An exact stored command returns its original event without another durable event."
    },
    {
      "id": "verified-rollback",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SQLiteLedger._rollback_or_poison",
      "match": "defined",
      "expected": "method",
      "claim": "Replay and recoverable failure return only after a clean rollback is proven."
    },
    {
      "id": "failure-settlement",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SQLiteLedger._settle_transaction_failure",
      "match": "defined",
      "expected": "method",
      "claim": "The outer guard distinguishes active rollback from an unknown commit outcome."
    },
    {
      "id": "poison-gate",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SQLiteLedger._ready_connection",
      "match": "defined",
      "expected": "method",
      "claim": "A poisoned ledger rejects further operations until it is closed."
    },
    {
      "id": "serialize-result",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_serialize",
      "match": "defined",
      "expected": "function",
      "claim": "Settled records become canonical compact JSON, pretty JSON, or history JSONL."
    },
    {
      "id": "stream-write",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_write",
      "match": "defined",
      "expected": "function",
      "claim": "The CLI loops until its Python stream accepts the payload and then flushes."
    },
    {
      "id": "success-exit",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "EXIT_SUCCESS",
      "match": "equals",
      "expected": "0",
      "claim": "Exit zero follows a completed write and flush to the supplied Python stream."
    },
    {
      "id": "state-exit",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "EXIT_STATE",
      "match": "equals",
      "expected": "11",
      "claim": "State conflicts such as revision and idempotency conflicts use exit 11."
    },
    {
      "id": "busy-exit",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "EXIT_BUSY",
      "match": "equals",
      "expected": "12",
      "claim": "Bounded writer or migration contention uses exit 12."
    },
    {
      "id": "uncertain-exit",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "EXIT_UNCERTAIN",
      "match": "equals",
      "expected": "14",
      "claim": "Unknown commit, failed rollback, and poisoned state use exit 14."
    },
    {
      "id": "output-exit",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "EXIT_OUTPUT",
      "match": "equals",
      "expected": "74",
      "claim": "Unavailable stdout or stderr output uses exit 74."
    },
    {
      "id": "interrupted-exit",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "EXIT_INTERRUPTED",
      "match": "equals",
      "expected": "130",
      "claim": "An interrupted operation or output attempt uses exit 130."
    },
    {
      "id": "retry-guidance",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_retry_guidance",
      "match": "defined",
      "expected": "function",
      "claim": "Machine-readable retry guidance varies by storage error code."
    },
    {
      "id": "command-retry",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_command_retry",
      "match": "defined",
      "expected": "function",
      "claim": "Mutations reuse the exact command while reads repeat the same invocation."
    },
    {
      "id": "error-emission",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_emit_error",
      "match": "defined",
      "expected": "function",
      "claim": "Even bounded error JSON can encounter an output failure or interruption."
    }
  ],
