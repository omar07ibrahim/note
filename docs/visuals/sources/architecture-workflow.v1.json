{
  "schema_version": 1,
  "diagram_kind": "architecture",
  "slug": "architecture-workflow",
  "entry": "caller-context",
  "title": "RecallLedger implemented architecture",
  "subtitle": "Explicit tenant context to verified SQLite state and machine-readable output",
  "description": "Source-derived architecture of the installed RecallLedger CLI, its bounded content and query input, lifecycle dispatcher, tenant-scoped SQLiteLedger API, atomic transition coordinator, canonical event contract, verified reads and reference search, durable event log and head projection, and JSON or JSONL output. Tenant identity is trusted caller context, not authentication. A persistent search index, model integration, and a network service are not represented.",
  "caption": "Source-derived architecture; not a runtime screenshot or benchmark",
  "canvas": {
    "width": 1600,
    "height": 1000
  },
  "bindings": [
    {
      "id": "cli-entry",
      "kind": "toml",
      "path": "pyproject.toml",
      "target": "project.scripts.recall-ledger",
      "match": "equals",
      "expected": "recall_ledger.cli:main",
      "claim": "The distribution installs one recall-ledger console entry point."
    },
    {
      "id": "trusted-context",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_parser",
      "match": "defined",
      "expected": "function",
      "claim": "The CLI requires an explicit data directory and tenant identifier."
    },
    {
      "id": "bounded-input",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_read_input_file",
      "match": "defined",
      "expected": "function",
      "claim": "Content and lexical queries enter through bounded non-symlink file readers."
    },
    {
      "id": "dispatch",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "_execute",
      "match": "defined",
      "expected": "function",
      "claim": "One invocation opens, dispatches one supported command, and closes the ledger."
    },
    {
      "id": "ledger-api",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SQLiteLedger",
      "match": "defined",
      "expected": "class",
      "claim": "SQLiteLedger owns the tenant-scoped public storage operations."
    },
    {
      "id": "write-guard",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "SQLiteLedger._apply_transition",
      "match": "defined",
      "expected": "method",
      "claim": "Mutations run inside the guarded write transaction state machine."
    },
    {
      "id": "transition-order",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_transition_in_transaction",
      "match": "defined",
      "expected": "function",
      "claim": "Command replay is checked before note state, identifier generation, and clock access."
    },
    {
      "id": "event-contract",
      "kind": "python",
      "path": "src/recall_ledger/events.py",
      "target": "LedgerEvent",
      "match": "defined",
      "expected": "class",
      "claim": "LedgerEvent defines canonical hash-linked created, revised, and tombstoned envelopes."
    },
    {
      "id": "insert-event",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_insert_event",
      "match": "defined",
      "expected": "function",
      "claim": "A newly derived canonical envelope is inserted into ledger_events."
    },
    {
      "id": "event-schema",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "_CREATE_EVENTS",
      "match": "contains",
      "expected": "CREATE TABLE ledger_events",
      "claim": "The versioned schema binds tenant, note, revision, command, hashes, and event bytes."
    },
    {
      "id": "head-write",
      "kind": "contract",
      "path": "docs/transaction-contract.md",
      "target": "write-protocol",
      "match": "contains",
      "expected": "insert note_heads or compare-and-swap its full old state",
      "claim": "Creation inserts a head and successors compare-and-swap its full prior state."
    },
    {
      "id": "head-schema",
      "kind": "python",
      "path": "src/recall_ledger/storage.py",
      "target": "_CREATE_HEADS",
      "match": "contains",
      "expected": "CREATE TABLE note_heads",
      "claim": "The head projection stores one current pointer per tenant and note."
    },
    {
      "id": "head-read",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_load_head",
      "match": "defined",
      "expected": "function",
      "claim": "Head reads reconcile the latest event row with the projected head."
    },
    {
      "id": "history-read",
      "kind": "python",
      "path": "src/recall_ledger/_ledger_operations.py",
      "target": "_history_in_transaction",
      "match": "defined",
      "expected": "function",
      "claim": "History reads verify one bounded page inside a consistent read snapshot."
    },
    {
      "id": "row-reconciliation",
      "kind": "contract",
      "path": "docs/transaction-contract.md",
      "target": "stored-row-reconciliation",
      "match": "contains",
      "expected": "Every event involved in a replay, head read, mutation, history page, or",
      "claim": "Touched and searched events are decoded from canonical bytes and reconciled with duplicated columns."
    },
    {
      "id": "machine-output",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "run_cli",
      "match": "defined",
      "expected": "function",
      "claim": "The CLI serializes a result only after the operation and ledger close settle."
    },
    {
      "id": "scope-boundary",
      "kind": "python",
      "path": "src/recall_ledger/cli.py",
      "target": "__doc__",
      "match": "contains",
      "expected": "This module does not authenticate tenants, infer identity from note content, or",
      "claim": "The operator CLI is not an authentication or model boundary."
    },
    {
      "id": "logical-deletion",
      "kind": "contract",
      "path": "docs/transaction-contract.md",
      "target": "optimistic-concurrency-and-terminal-state",
      "match": "contains",
      "expected": "This is logical deletion, not physical",
      "claim": "A tombstone hides the live note but does not erase earlier event history."
    }
  ],
