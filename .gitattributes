# Auto detect text files and perform LF normalization
* text=auto

# Frozen evaluation hashes must survive cross-platform checkouts byte-for-byte.
evals/lexical-v1/*.json text eol=lf
evals/lexical-v1/*.md text eol=lf
.github/workflows/*.yml text eol=lf
requirements-dev.lock text eol=lf
docs/visuals/*.svg text eol=lf
docs/visuals/sources/*.json text eol=lf
